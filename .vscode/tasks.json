{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "현대자동차 앱 개발 시작",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "streamlit",
        "run",
        "${workspaceFolder}/app.py",
        "--server.port=8502",
        "--browser.gatherUsageStats=false",
        "--server.fileWatcherType=none"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
